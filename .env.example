# Public browser configuration (safe to expose; required by the Supabase client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-side Supabase configuration (required by API routes and auth middleware)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Required for Hub chat and image generation routes
LOVABLE_API_KEY=your_lovable_gateway_key

# Optional server-side providers. When absent, users can still use Hub models;
# personal OpenAI/Anthropic keys are stored per user in Supabase.
# GEMINI_API_KEY and HUGGING_FACE_API_KEY also serve as automatic fallbacks for image
# generation (in this order: Lovable gateway -> Gemini -> Hugging Face) if you want
# /api/images to survive an outage of the Lovable gateway.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGING_FACE_API_KEY=
MISTRAL_API_KEY=

# Dedicated keys used ONLY by the "Auto" model router (src/lib/auto-router.server.ts).
# Separate from GROQ_API_KEY / MISTRAL_API_KEY above so router traffic never competes
# with (or gets billed alongside) real Groq/Mistral chat answers. When both are absent,
# "Auto" falls back straight to a fixed default model.
GROQ_ROUTER_API_KEY=
MISTRAL_ROUTER_API_KEY=

# Only needed by server jobs that use the service-role Supabase client or cron verification.
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
